		"devdoc": {
			"details": "Ce contrat intelligent gère les dossiers médicaux des patients de manière sécurisée et décentralisée. Il permet à des médecins autorisés d'ajouter des dossiers pour les patients. Les médecins peuvent consulter l'historique de n'importe quel patient. Les patients peuvent uniquement consulter leur propre historique médical. Le propriétaire du contrat est responsable de l'ajout et de la révocation des médecins.",
			"kind": "dev",
			"methods": {
				"addDoctor(address)": {
					"details": "Seul le propriétaire du contrat peut appeler cette fonction.",
					"params": {
						"_doctorAddress": "L'adresse Ethereum du médecin à ajouter."
					}
				},
				"addMedicalRecord(address,string,string)": {
					"details": "Gère à la fois les nouveaux patients et les patients existants. Si le patient n'existe pas, son historique est créé. S'il existe, le dossier est ajouté à son historique. Seul un médecin autorisé peut appeler cette fonction.",
					"params": {
						"_diagnosis": "Le diagnostic de la visite.",
						"_patientAddress": "L'adresse du patient concerné.",
						"_prescription": "La prescription médicale."
					}
				},
				"constructor": {
					"details": "Le constructeur initialise le propriétaire du contrat lors du déploiement."
				},
				"getPatientRecords(address)": {
					"details": "L'accès est conditionnel : - Un médecin peut voir l'historique de n'importe quel patient. - Un patient peut voir uniquement son propre historique.",
					"params": {
						"_patientAddress": "L'adresse du patient dont on veut consulter l'historique."
					},
					"returns": {
						"_0": "MedicalRecord[] La liste des dossiers médicaux du patient."
					}
				},
				"getRecordsCount(address)": {
					"details": "Utile pour savoir rapidement combien de visites un patient a eues.",
					"params": {
						"_patientAddress": "L'adresse du patient."
					},
					"returns": {
						"_0": "uint Le nombre total de dossiers médicaux."
					}
				},
				"hasMedicalHistory(address)": {
					"details": "C'est une fonction utilitaire pour les interfaces utilisateur.",
					"params": {
						"_patientAddress": "L'adresse du patient à vérifier."
					},
					"returns": {
						"_0": "bool Vrai si le patient a au moins un dossier, sinon faux."
					}
				},
				"removeDoctor(address)": {
					"details": "Seul le propriétaire du contrat peut appeler cette fonction.",
					"params": {
						"_doctorAddress": "L'adresse Ethereum du médecin à révoquer."
					}
				}
			},
			"title": "EHealth",
			"version": 1
